{
  "name": "vibuzz",
  "version": "1.0.0",
  "private": true,
  "description": "Vibuzz \u2014 personagens com IA, mem\u00f3ria permanente e comunidade. Create. Connect. Remember.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @vibuzz/api",
    "dev:mobile": "npm run start -w @vibuzz/mobile",
    "build:api": "npm run build -w @vibuzz/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "node scripts/validate-migrations.mjs",
    "check": "npm run typecheck && npm run test && npm run test:db",
    "build:edge": "npm run build:edge -w @vibuzz/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16"
  }
}
