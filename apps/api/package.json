{
  "name": "@vibuzz/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "zod": "^3.25.0",
    "hono": "^4.7.0",
    "@hono/node-server": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vibuzz/shared": "*",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
